.sub { color: #5a6673; font-size: 10pt; margin-top: 0; }
.formula { font-family: Consolas, "Courier New", monospace; font-size: 10pt; background: #f4f6f9;
           border-left: 3pt solid #2f5c96; padding: 8pt 10pt; margin: 8pt 0; white-space: pre-wrap; }
table { border-collapse: collapse; width: 100%; margin: 8pt 0; font-size: 10pt; }
th { background: #1a3d6d; color: #ffffff; text-align: left; padding: 5pt 7pt; }
td { border-bottom: 1pt solid #d8dee6; padding: 5pt 7pt; vertical-align: top; }
